// CRM schema — ported from the Laravel application (df-laravel-crm).
// Table / column names are mapped to the original snake_case names so
// the resulting MySQL database stays compatible with the legacy app.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Tenancy / auth
// ---------------------------------------------------------------------------

model Organization {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  mobile    String?
  address   String?
  city      String?
  state     String?
  zipcode   String?
  country   String?
  status    Int      @default(1)
  logo      String?
  gst       String?
  createdBy Int      @default(0) @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           User[]
  roles           Role[]
  leads           Lead[]
  leadStatuses    LeadStatus[]
  leadSubStatuses LeadSubStatus[]
  leadSources     LeadSource[]
  leadTypes       LeadType[]
  institutes      Institute[]
  teams           Team[]
  designations    Designation[]
  campaigns       Campaign[]
  marketingEvents MarketingEvent[]
  generalSetting  GeneralSetting?
  emailTemplates  EmailTemplate[]
  messageTemplates MessageTemplate[]
  whatsappTemplates WhatsappTemplate[]
  leadUploads     LeadUpload[]
  leadIntegrations LeadIntegration[]

  @@map("organizations")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  permissions   Json?
  lastLogin     DateTime? @map("last_login")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  location      String?
  status        Int       @default(1)
  organizationId Int?     @map("organization_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization  Organization? @relation(fields: [organizationId], references: [id])
  roles         RoleUser[]
  teamMembers   TeamMember[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  createdLeads  Lead[]            @relation("LeadCreator")
  leadNotes     LeadNote[]
  activityLogs  LeadActivityLog[]
  leadUploads   LeadUpload[]

  @@map("users")
}

model Role {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String
  permissions   Json?
  organizationId Int?     @map("organization_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        RoleUser[]

  @@map("roles")
}

model RoleUser {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("role_users")
}

// ---------------------------------------------------------------------------
// Lead masters
// ---------------------------------------------------------------------------

model LeadStatus {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  name           String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization?   @relation(fields: [organizationId], references: [id])
  subStatuses   LeadSubStatus[]
  leads         Lead[]

  @@map("lead_statuses")
}

model LeadSubStatus {
  id             Int      @id @default(autoincrement())
  leadStatusId   Int      @map("lead_status_id")
  organizationId Int?     @map("organization_id")
  name           String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  status       LeadStatus    @relation(fields: [leadStatusId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  leads        Lead[]

  @@map("lead_sub_statuses")
}

model LeadSource {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  name               String
  status             Int      @default(1)
  leadCount          Int      @default(0) @map("lead_count")
  billingSetupAmount Decimal  @default(0) @map("billing_setup_amount") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  leads        Lead[]

  @@map("lead_sources")
}

model LeadType {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  leads        Lead[]

  @@map("lead_types")
}

// ---------------------------------------------------------------------------
// Academic masters
// ---------------------------------------------------------------------------

model Institute {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?  @db.Text
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  programs     Program[]
  leads        Lead[]

  @@map("institutes")
}

model Program {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  description String?  @db.Text
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@map("programs")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Campaign {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @default(0) @map("organization_id")
  name             String
  subject          String?
  status           String?
  type             String?
  marketingEventId Int?     @map("marketing_event_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  marketingEvent MarketingEvent? @relation(fields: [marketingEventId], references: [id])
  leads          Lead[]

  @@map("campaigns")
}

model MarketingEvent {
  id             Int       @id @default(autoincrement())
  organizationId Int       @default(0) @map("organization_id")
  name           String
  description    String?
  date           DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  campaigns    Campaign[]

  @@map("marketing_events")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id                   Int       @id @default(autoincrement())
  name                 String?
  mobile               String
  alternateMobile      String?   @map("alternate_mobile")
  email                String?
  city                 String?
  state                String?
  country              String?
  organizationId       Int       @map("organization_id")
  instituteId          Int?      @map("institute_id")
  programmeId          Int?      @map("programme_id")
  leadSourceId         Int?      @map("lead_source_id")
  campaignId           Int?      @map("lead_campaign_id")
  typeId               Int?      @map("type_id")
  leadStatusId         Int?      @map("lead_status_id")
  leadSubStatusId      Int?      @map("lead_sub_status_id")
  leadScore            Int       @default(0) @map("lead_score")
  leadWeightCount      Int       @default(0) @map("lead_weight_count")
  leadAssignTo         Int?      @map("lead_assign_to")
  createdBy            Int?      @map("created_by")
  nextFollowupAt       DateTime? @map("next_followup_at")
  leadRegistrationDate DateTime? @map("lead_registration_date")
  extraFields          Json?     @map("extra_fields_json")
  password             String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  institute    Institute?             @relation(fields: [instituteId], references: [id])
  programme    Program?               @relation(fields: [programmeId], references: [id])
  source       LeadSource?            @relation(fields: [leadSourceId], references: [id])
  campaign     Campaign?              @relation(fields: [campaignId], references: [id])
  type         LeadType?              @relation(fields: [typeId], references: [id])
  status       LeadStatus?            @relation(fields: [leadStatusId], references: [id])
  subStatus    LeadSubStatus?         @relation(fields: [leadSubStatusId], references: [id])
  assignee     User?                  @relation("LeadAssignee", fields: [leadAssignTo], references: [id])
  creator      User?                  @relation("LeadCreator", fields: [createdBy], references: [id])
  notes        LeadNote[]
  communications LeadCommunicationLog[]
  activityLogs   LeadActivityLog[]

  @@index([organizationId])
  @@index([leadStatusId])
  @@index([leadSourceId])
  @@index([leadAssignTo])
  @@index([mobile])
  @@map("leads")
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  note      String   @db.Text
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator User? @relation(fields: [createdBy], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

model LeadCommunicationLog {
  id        Int       @id @default(autoincrement())
  leadId    Int?      @map("lead_id")
  channel   String    // email | sms | whatsapp | call | system
  direction String?   // inbound | outbound
  purpose   String?
  createdAt DateTime  @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("lead_communication_logs")
}

model LeadActivityLog {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  userId    Int?     @map("user_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activity_logs")
}

// ---------------------------------------------------------------------------
// Teams / HR
// ---------------------------------------------------------------------------

model Team {
  id             Int      @id @default(autoincrement())
  name           String?
  organizationId Int      @default(0) @map("organization_id")
  status         Int      @default(1)
  head           Int      @default(0)
  createdBy      Int      @default(0) @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  members      TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId Int @map("team_id")
  userId Int @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Designation {
  id             Int      @id @default(autoincrement())
  name           String?
  status         Int      @default(1)
  organizationId Int      @default(0) @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("designation")
}

// ---------------------------------------------------------------------------
// Settings / geo
// ---------------------------------------------------------------------------

model GeneralSetting {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @unique @map("organization_id")
  appName        String?  @map("app_name")
  currency       String?
  timezone       String?
  dateFormat     String?  @map("date_format")
  logo           String?
  favicon        String?
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("general_settings")
}

model Country {
  id        Int     @id @default(autoincrement())
  name      String?
  code      Int?
  states    State[]

  @@map("countries")
}

model State {
  id        Int    @id @default(autoincrement())
  countryId Int    @default(0) @map("country_id")
  name      String?
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@map("states")
}

model City {
  id      Int    @id @default(autoincrement())
  stateId Int    @map("state_id")
  name    String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@map("cities")
}

// ---------------------------------------------------------------------------
// Templates (email / sms / whatsapp)
// ---------------------------------------------------------------------------

model EmailTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String?
  category       String?
  subject        String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("email_templates")
}

model MessageTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String?
  category       String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("message_templates")
}

model WhatsappTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String
  category       String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("whatsapp_templates")
}

// ---------------------------------------------------------------------------
// Lead imports
// ---------------------------------------------------------------------------

model LeadUpload {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int       @map("user_id")
  fileName       String?   @map("file_name")
  totalRows      Int       @default(0) @map("total_rows")
  validRows      Int       @default(0) @map("valid_rows")
  duplicateRows  Int       @default(0) @map("duplicate_rows")
  failedRows     Int       @default(0) @map("failed_rows")
  status         String    @default("pending") // pending | processing | completed | partial | failed
  errorMessage   String?   @db.Text @map("error_message")
  uploadType     String?   @map("upload_type")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("lead_uploads")
}

// ---------------------------------------------------------------------------
// Lead integrations & webhook logs
// ---------------------------------------------------------------------------

model LeadIntegration {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  provider       String   // facebook | instagram | google
  isEnabled      Boolean  @default(false) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@map("lead_integrations")
}

model LeadIntegrationCredential {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  provider       String
  key            String
  value          String   @db.Text
  isEncrypted    Boolean  @default(true) @map("is_encrypted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("lead_integration_credentials")
}

model LeadWebhookLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  provider       String
  eventType      String?  @map("event_type")
  requestHeaders Json?    @map("request_headers")
  payload        Json
  isProcessed    Boolean  @default(false) @map("is_processed")
  errorMessage   String?  @db.Text @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("lead_webhook_logs")
}
