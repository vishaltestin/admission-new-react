// CRM schema — ported from the Laravel application (df-laravel-crm).
// Table / column names are mapped to the original snake_case names so
// the resulting MySQL database stays compatible with the legacy app.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Tenancy / auth
// ---------------------------------------------------------------------------

model Organization {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String?
  mobile    String?
  address   String?
  city      String?
  state     String?
  zipcode   String?
  country   String?
  status    Int      @default(1)
  logo      String?
  gst       String?
  createdBy Int      @default(0) @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  roles             Role[]
  leads             Lead[]
  leadStatuses      LeadStatus[]
  leadSubStatuses   LeadSubStatus[]
  leadSources       LeadSource[]
  leadTypes         LeadType[]
  institutes        Institute[]
  teams             Team[]
  designations      Designation[]
  campaigns         Campaign[]
  marketingEvents   MarketingEvent[]
  generalSetting    GeneralSetting?
  emailTemplates    EmailTemplate[]
  messageTemplates  MessageTemplate[]
  whatsappTemplates WhatsappTemplate[]
  leadUploads       LeadUpload[]
  leadIntegrations  LeadIntegration[]
  webhooks          Webhook[]
  automationRules   AutomationRule[]
  webForms          WebForm[]
  landingPages      LandingPage[]
  coupons           Coupon[]

  @@map("organizations")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  permissions    Json?
  lastLogin      DateTime? @map("last_login")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  location       String?
  status         Int       @default(1)
  organizationId Int?      @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization  Organization?     @relation(fields: [organizationId], references: [id])
  roles         RoleUser[]
  teamMembers   TeamMember[]
  assignedLeads Lead[]            @relation("LeadAssignee")
  createdLeads  Lead[]            @relation("LeadCreator")
  leadNotes     LeadNote[]
  activityLogs  LeadActivityLog[]
  leadUploads   LeadUpload[]

  @@map("users")
}

model Role {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  permissions    Json?
  organizationId Int?     @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        RoleUser[]

  @@map("roles")
}

model RoleUser {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("role_users")
}

// ---------------------------------------------------------------------------
// Lead masters
// ---------------------------------------------------------------------------

model LeadStatus {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  name           String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization?   @relation(fields: [organizationId], references: [id])
  subStatuses  LeadSubStatus[]
  leads        Lead[]

  @@map("lead_statuses")
}

model LeadSubStatus {
  id             Int      @id @default(autoincrement())
  leadStatusId   Int      @map("lead_status_id")
  organizationId Int?     @map("organization_id")
  name           String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  status       LeadStatus    @relation(fields: [leadStatusId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  leads        Lead[]

  @@map("lead_sub_statuses")
}

model LeadSource {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @map("organization_id")
  name               String
  status             Int      @default(1)
  leadCount          Int      @default(0) @map("lead_count")
  billingSetupAmount Decimal  @default(0) @map("billing_setup_amount") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  leads        Lead[]
  webForms     WebForm[]

  @@map("lead_sources")
}

model LeadType {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  leads        Lead[]
  webForms     WebForm[]

  @@map("lead_types")
}

// ---------------------------------------------------------------------------
// Academic masters
// ---------------------------------------------------------------------------

model Institute {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?  @db.Text
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  programs     Program[]
  leads        Lead[]

  @@map("institutes")
}

model Program {
  id          Int      @id @default(autoincrement())
  instituteId Int      @map("institute_id")
  name        String
  description String?  @db.Text
  status      Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@map("programs")
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Campaign {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @default(0) @map("organization_id")
  name             String
  subject          String?
  status           String?
  type             String?
  marketingEventId Int?     @map("marketing_event_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  marketingEvent MarketingEvent? @relation(fields: [marketingEventId], references: [id])
  leads          Lead[]
  webForms       WebForm[]

  @@map("campaigns")
}

model MarketingEvent {
  id             Int       @id @default(autoincrement())
  organizationId Int       @default(0) @map("organization_id")
  name           String
  description    String?
  date           DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  campaigns    Campaign[]

  @@map("marketing_events")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id                   Int       @id @default(autoincrement())
  name                 String?
  mobile               String
  alternateMobile      String?   @map("alternate_mobile")
  email                String?
  city                 String?
  state                String?
  country              String?
  organizationId       Int       @map("organization_id")
  instituteId          Int?      @map("institute_id")
  programmeId          Int?      @map("programme_id")
  leadSourceId         Int?      @map("lead_source_id")
  campaignId           Int?      @map("lead_campaign_id")
  typeId               Int?      @map("type_id")
  leadStatusId         Int?      @map("lead_status_id")
  leadSubStatusId      Int?      @map("lead_sub_status_id")
  leadScore            Int       @default(0) @map("lead_score")
  leadWeightCount      Int       @default(0) @map("lead_weight_count")
  leadAssignTo         Int?      @map("lead_assign_to")
  createdBy            Int?      @map("created_by")
  nextFollowupAt       DateTime? @map("next_followup_at")
  leadRegistrationDate DateTime? @map("lead_registration_date")
  extraFields          Json?     @map("extra_fields_json")
  password             String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization   Organization           @relation(fields: [organizationId], references: [id])
  institute      Institute?             @relation(fields: [instituteId], references: [id])
  programme      Program?               @relation(fields: [programmeId], references: [id])
  source         LeadSource?            @relation(fields: [leadSourceId], references: [id])
  campaign       Campaign?              @relation(fields: [campaignId], references: [id])
  type           LeadType?              @relation(fields: [typeId], references: [id])
  status         LeadStatus?            @relation(fields: [leadStatusId], references: [id])
  subStatus      LeadSubStatus?         @relation(fields: [leadSubStatusId], references: [id])
  assignee       User?                  @relation("LeadAssignee", fields: [leadAssignTo], references: [id])
  creator        User?                  @relation("LeadCreator", fields: [createdBy], references: [id])
  notes          LeadNote[]
  communications LeadCommunicationLog[]
  activityLogs   LeadActivityLog[]

  @@index([organizationId])
  @@index([leadStatusId])
  @@index([leadSourceId])
  @@index([leadAssignTo])
  @@index([mobile])
  @@map("leads")
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  note      String   @db.Text
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator User? @relation(fields: [createdBy], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

model LeadCommunicationLog {
  id        Int      @id @default(autoincrement())
  leadId    Int?     @map("lead_id")
  channel   String // email | sms | whatsapp | call | system
  direction String? // inbound | outbound
  purpose   String?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("lead_communication_logs")
}

model LeadActivityLog {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  userId    Int?     @map("user_id")
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_activity_logs")
}

// ---------------------------------------------------------------------------
// Teams / HR
// ---------------------------------------------------------------------------

model Team {
  id             Int      @id @default(autoincrement())
  name           String?
  organizationId Int      @default(0) @map("organization_id")
  status         Int      @default(1)
  head           Int      @default(0)
  createdBy      Int      @default(0) @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  members      TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId Int @map("team_id")
  userId Int @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model Designation {
  id             Int      @id @default(autoincrement())
  name           String?
  status         Int      @default(1)
  organizationId Int      @default(0) @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("designation")
}

// ---------------------------------------------------------------------------
// Settings / geo
// ---------------------------------------------------------------------------

model GeneralSetting {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @unique @map("organization_id")
  appName        String?  @map("app_name")
  currency       String?
  timezone       String?
  dateFormat     String?  @map("date_format")
  logo           String?
  favicon        String?
  status         Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("general_settings")
}

model Country {
  id     Int     @id @default(autoincrement())
  name   String?
  code   Int?
  states State[]

  @@map("countries")
}

model State {
  id        Int     @id @default(autoincrement())
  countryId Int     @default(0) @map("country_id")
  name      String?
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@map("states")
}

model City {
  id      Int    @id @default(autoincrement())
  stateId Int    @map("state_id")
  name    String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@map("cities")
}

// ---------------------------------------------------------------------------
// Templates (email / sms / whatsapp)
// ---------------------------------------------------------------------------

model EmailTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String?
  category       String?
  subject        String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("email_templates")
}

model MessageTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String?
  category       String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("message_templates")
}

model WhatsappTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  createdBy      Int      @default(0) @map("created_by")
  sendBy         String?  @map("send_by")
  title          String
  category       String?
  message        String   @db.LongText
  variables      Json?    @map("variables_json")
  editable       Boolean  @default(true)
  sentCount      Int      @default(0) @map("sent_count")
  status         String   @default("active") // active | inactive
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("whatsapp_templates")
}

// ---------------------------------------------------------------------------
// Lead imports
// ---------------------------------------------------------------------------

model LeadUpload {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  userId         Int       @map("user_id")
  fileName       String?   @map("file_name")
  totalRows      Int       @default(0) @map("total_rows")
  validRows      Int       @default(0) @map("valid_rows")
  duplicateRows  Int       @default(0) @map("duplicate_rows")
  failedRows     Int       @default(0) @map("failed_rows")
  status         String    @default("pending") // pending | processing | completed | partial | failed
  errorMessage   String?   @map("error_message") @db.Text
  uploadType     String?   @map("upload_type")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("lead_uploads")
}

// ---------------------------------------------------------------------------
// Lead integrations & webhook logs
// ---------------------------------------------------------------------------

model LeadIntegration {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  provider       String // facebook | instagram | google
  isEnabled      Boolean  @default(false) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@map("lead_integrations")
}

model LeadIntegrationCredential {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  provider       String
  key            String
  value          String   @db.Text
  isEncrypted    Boolean  @default(true) @map("is_encrypted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("lead_integration_credentials")
}

model LeadWebhookLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  provider       String
  eventType      String?  @map("event_type")
  requestHeaders Json?    @map("request_headers")
  payload        Json
  isProcessed    Boolean  @default(false) @map("is_processed")
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("lead_webhook_logs")
}

// ---------------------------------------------------------------------------
// Outgoing webhooks
// ---------------------------------------------------------------------------

model Webhook {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(0) @map("organization_id")
  name           String
  entityType     String   @map("entity_type") // lead | status_change | any
  description    String?
  method         String   @default("POST")
  endPoint       String   @map("end_point")
  queryParams    Json?    @map("query_params")
  headers        Json?
  payloadType    String?  @map("payload_type") // json | form
  rawPayloadType String?  @map("raw_payload_type")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("webhooks")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

model AutomationRule {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  name           String?
  triggerEvent   String?  @map("trigger_event") // lead_created | status_changed
  conditions     Json?
  actions        Json
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization?       @relation(fields: [organizationId], references: [id])
  logs         AutomationRuleLog[]

  @@map("automation_rules")
}

model AutomationRuleLog {
  id           Int      @id @default(autoincrement())
  orgId        Int      @map("org_id")
  ruleId       Int      @map("rule_id")
  leadId       Int      @map("lead_id")
  triggerEvent String   @map("trigger_event")
  actionType   String   @map("action_type")
  status       String   @default("success") // success | error | skipped
  message      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([ruleId])
  @@map("automation_rule_logs")
}

// ---------------------------------------------------------------------------
// Channel logs & settings
// ---------------------------------------------------------------------------

model EmailLog {
  id                 Int       @id @default(autoincrement())
  communicationLogId Int?      @map("communication_log_id")
  organizationId     Int?      @map("organization_id")
  userId             Int?      @map("user_id")
  templateName       String?   @map("template_name")
  toEmail            String?   @map("to_email")
  subject            String?
  body               String?   @db.LongText
  status             String?
  responseMessage    String?   @map("response_message") @db.Text
  provider           String?
  sentBy             Int?      @map("sent_by")
  attempts           Int       @default(0)
  sentAt             DateTime? @map("sent_at")
  lastAttemptAt      DateTime? @map("last_attempt_at")
  leadId             Int?      @map("lead_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("email_logs")
}

model SmsLog {
  id                 Int       @id @default(autoincrement())
  communicationLogId Int?      @map("communication_log_id")
  organizationId     Int       @map("organization_id")
  leadId             Int?      @map("lead_id")
  mobile             String
  message            String    @db.Text
  provider           String?   @default("demo")
  providerMessageId  String?   @map("provider_message_id")
  status             String?   @default("pending")
  responseJson       String?   @map("response_json") @db.Text
  sentBy             Int?      @map("sent_by")
  fullUrl            String?   @map("full_url") @db.Text
  attempts           Int       @default(0)
  sentAt             DateTime? @map("sent_at")
  lastAttemptAt      DateTime? @map("last_attempt_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("sms_logs")
}

model WhatsappLog {
  id                 Int       @id @default(autoincrement())
  communicationLogId Int?      @map("communication_log_id")
  organizationId     Int       @map("organization_id")
  leadId             Int?      @map("lead_id")
  mobile             String?
  templateId         String?   @map("template_id")
  message            String?   @db.Text
  mediaUrl           String?   @map("media_url") @db.Text
  provider           String?   @default("demo")
  providerMessageId  String?   @map("provider_message_id")
  status             String?   @default("pending")
  responseJson       String?   @map("response_json") @db.Text
  sentBy             Int?      @map("sent_by")
  attempts           Int       @default(0)
  sentAt             DateTime? @map("sent_at")
  lastAttemptAt      DateTime? @map("last_attempt_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_logs")
}

model EmailSetting {
  id              Int      @id @default(autoincrement())
  organizationId  Int?     @unique @map("organization_id")
  mailMailer      String?  @map("mail_mailer")
  mailHost        String?  @map("mail_host")
  mailPort        String?  @map("mail_port")
  mailUsername    String?  @map("mail_username")
  mailPassword    String?  @map("mail_password")
  mailEncryption  String?  @map("mail_encryption")
  mailFromAddress String?  @map("mail_from_address")
  mailFromName    String?  @map("mail_from_name")
  mailValidateSsl Int      @default(0) @map("mail_validatessl")
  status          Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

// ---------------------------------------------------------------------------
// Phase 4 — Capture: webforms, landing pages, coupons
// ---------------------------------------------------------------------------

model WebForm {
  id                    Int      @id @default(autoincrement())
  organizationId        Int      @default(0) @map("organization_id")
  /**
   * Public slug used in /f/{formId} URLs.
   */
  formId                String   @map("form_id")
  title                 String
  description           String?
  submitButtonLabel     String   @default("Submit") @map("submit_button_label")
  /**
   * message | redirect
   */
  submitSuccessAction   String   @default("message") @map("submit_success_action")
  submitSuccessContent  String?  @map("submit_success_content")
  createLead            Boolean  @default(true) @map("create_lead")
  backgroundColor       String?  @map("background_color")
  formBackgroundColor   String?  @map("form_background_color")
  formTitleColor        String?  @map("form_title_color")
  formSubmitButtonColor String?  @map("form_submit_button_color")
  attributeLabelColor   String?  @map("attribute_label_color")
  viewCount             Int      @default(0) @map("view_count")
  submitCount           Int      @default(0) @map("submit_count")
  leadSourceId          Int?     @map("lead_source_id")
  campaignId            Int?     @map("lead_campaign_id")
  typeId                Int?     @map("type_id")
  applicationFormId     Int?     @map("application_form_id")
  extraFields           Json?    @map("extra_fields_json")
  createdBy             Int?     @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id])
  source       LeadSource?        @relation(fields: [leadSourceId], references: [id])
  campaign     Campaign?          @relation(fields: [campaignId], references: [id])
  type         LeadType?          @relation(fields: [typeId], references: [id])
  attributes   WebFormAttribute[]

  @@unique([organizationId, formId])
  @@index([organizationId])
  @@map("web_forms")
}

model WebFormAttribute {
  id           Int      @id @default(autoincrement())
  webFormId    Int      @map("web_form_id")
  name         String
  placeholder  String?
  isRequired   Boolean  @default(false) @map("is_required")
  isHidden     Boolean  @default(false) @map("is_hidden")
  sortOrder    Int      @default(0) @map("sort_order")
  /**
   * text | email | number | tel | date | textarea | select | checkbox | radio
   */
  type         String   @default("text")
  /**
   * Comma separated options for select/radio/checkbox.
   */
  options      String?
  defaultValue String?  @map("default_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  webForm WebForm @relation(fields: [webFormId], references: [id], onDelete: Cascade)

  @@index([webFormId])
  @@map("web_form_attributes")
}

model LandingPage {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(0) @map("organization_id")
  campaignId     Int?     @map("campaign_id")
  slug           String
  title          String?
  layoutName     String   @default("velzon") @map("layout_name")
  status         Int      @default(1)
  meta           Json?
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  sections     LandingPageSection[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("landing_pages")
}

model LandingPageSection {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  sectionKey  String   @map("section_key") // hero | features | about | form
  contentJson Json     @map("content_json")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
  @@map("landing_page_sections")
}

model Coupon {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  code           String
  name           String?
  /**
   * flat | percent
   */
  type           String    @default("flat")
  value          Decimal   @default(0) @db.Decimal(10, 2)
  minAmount      Decimal?  @map("min_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?  @map("max_discount") @db.Decimal(10, 2)
  /**
   * single | multiple
   */
  usageType      String    @default("single") @map("usage_type")
  usageLimit     Int?      @map("usage_limit")
  usedCount      Int       @default(0) @map("used_count")
  startAt        DateTime? @map("start_at")
  endAt          DateTime? @map("end_at")
  status         Int       @default(1)
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  usages       CouponUsage[]

  @@unique([organizationId, code])
  @@map("coupons")
}

model CouponUsage {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  couponId       Int      @map("coupon_id")
  leadId         Int?     @map("lead_id")
  applicationId  Int?     @map("application_id")
  usedByUserId   Int?     @map("used_by_user_id")
  usedAt         DateTime @default(now()) @map("used_at")
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  orderAmount    Decimal  @default(0) @map("order_amount") @db.Decimal(10, 2)
  metaJson       Json?    @map("meta_json")
  createdAt      DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([organizationId])
  @@map("coupon_usages")
}
