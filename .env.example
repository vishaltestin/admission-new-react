# MySQL / MariaDB connection string used by Prisma (adapter-mariadb).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://johndoe:randompassword@localhost:3306/df_crm"

# Auth.js (next-auth v5) secret. Generate one with: npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app (needed in production / behind a proxy)
# AUTH_URL="http://localhost:3000"

# Bearer token for the scheduled-campaign sender (see vercel.json cron).
# Any long random string works; without it the route is NOT exposed.
# Generate: openssl rand -hex 32
CRON_SECRET=""
